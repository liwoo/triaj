# Triage model — passed directly to the Anthropic client.
# The graph uses `anthropic.Anthropic().messages.create(model=...)` so this
# must be a valid Anthropic model ID, not a provider:model string.
TRIAGE_MODEL=claude-opus-4-6

# Required: Anthropic API key for the categorize node.
ANTHROPIC_API_KEY=

# Supabase — needed when running against the real `cases` table and the
# policy-documents / uploads-quarantine buckets. Leave blank to run in
# in-memory mode (writes go to a list, policies read from _POLICY_WRITES).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: service-role key overrides the anon key for writes.
SUPABASE_SERVICE_ROLE_KEY=

# LangSmith — set TRACING=true to send agent traces to https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_replace_me
LANGSMITH_PROJECT=triaj-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Framework version stamped onto every decision for audit reproducibility.
FRAMEWORK_VERSION=2026.04.01
