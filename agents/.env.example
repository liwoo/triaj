# LangSmith — set TRACING=true to send agent traces to https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_replace_me
LANGSMITH_PROJECT=triaj-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Triage model — passed to langchain.chat_models.init_chat_model.
# Format is "<provider>:<model>". Swap providers freely; the agent only sees
# anonymised text, so any compliant API endpoint is acceptable.
TRIAGE_MODEL=openai:gpt-4o-mini

# Provider keys — only set the one matching TRIAGE_MODEL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Framework version stamped onto every decision for audit reproducibility.
FRAMEWORK_VERSION=2026.04.01
