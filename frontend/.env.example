# Supabase connection — get these from your Supabase dashboard (Settings > API).
# Leave blank or remove this file to run on local fixture data only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — used server-side only (API routes, webhooks). Never exposed to the browser.
# Find it in Supabase dashboard: Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the Supabase database webhook. Set the same value in
# Supabase (Database > Webhooks) as the x-webhook-secret header.
# If left blank the endpoint accepts all requests (fine for local dev).
WEBHOOK_SECRET=

# Storage bucket names — override if your Supabase buckets are named differently.
NEXT_PUBLIC_BUCKET_QUARANTINE=uploads-quarantine
NEXT_PUBLIC_BUCKET_VERIFIED=uploads-verified
NEXT_PUBLIC_BUCKET_POLICIES=policy-documents
